<!--
package: com.foo

level1:
    param1: the first threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the first threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)

level2:
    param1: the second threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the second threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)

level3:
    param1: the second threshold of temperature rise
    param2: hysteresis temperature of param1 when temperature down
    param3: brightness ratio when temperature over the second threshold
    param4: luxlimit. the threshold value of ambient light intensity, when
             the ambient lux is lower than it, it is indoors.(0: invalid)
-->
<packages>
    <!--<black_list_config package="com.transsion.XOSLauncher"/>-->
    <white_list_config_autolight_on package="^.*$" level1="40,38,80,2000" level2="47,45,70,2000"/>
    <white_list_config_auto_light_off package="com.android.chrome" level1="38,36,80,0" level2="40,38,65,0"/>
    <white_list_config_auto_light_off package="com.whatsapp" level1="40,38,80,0" level2="42,40,60,0"/>
    <white_list_config_auto_light_off package="com.transsion.camera" level1="40,38,80,0" level2="42,40,65,0"/>
    <white_list_config_auto_light_off package="com.dts.freefireth" level1="40,38,80,0" level2="42,40,60,0"/>
    <white_list_config_auto_light_off package="com.tencent.ig" level1="40,38,80,0" level2="42,40,60,0"/>
    <white_list_config_auto_light_off package="com.mobile.legends" level1="40,38,80,0" level2="42,40,60,0"/>
    <white_list_config_auto_light_off package="com.android.vending" level1="40,38,80,0" level2="42,40,60,0"/>
    <white_list_config_auto_light_off package="com.ss.android.ugc.aweme" level1="40,38,80,0" level2="42,40,60,0"/>
</packages>
